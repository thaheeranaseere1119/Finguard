# FinGuard AI configuration. Copy to .env and fill in. NEVER commit .env. All values below are placeholders.

# --- Core
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO
POSTGRES_USER=finguard
POSTGRES_PASSWORD=change-me-generate-a-long-random-value
POSTGRES_DB=finguard
# Local (non-Docker) runs use DATABASE_URL directly:
DATABASE_URL=postgresql+psycopg://finguard:change-me@localhost:5432/finguard
REDIS_URL=redis://localhost:6379/0
USE_JOB_QUEUE=true                      # false = run OCR jobs inline (single-process demos/tests)

# --- Auth (production refuses to start with a short secret or insecure cookies)
JWT_SECRET=generate-with-python-secrets-token_urlsafe-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false                     # must be true in production (HTTPS)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Documents & OCR
STORAGE_DIR=./backend/storage           # private directory, never web-served
MAX_UPLOAD_BYTES=15728640
TESSDATA_PREFIX=                        # e.g. /usr/share/tesseract-ocr/5/tessdata (Docker sets this)
OCR_LANGUAGE=eng

# --- LLM provider for extraction proposals, the agent and RAG answers: mock | gemini | openai | anthropic | groq
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash                  # groq: llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Payouts. Sandbox is the default; live mode is refused unless ENVIRONMENT=production AND the acknowledgement is set.
PAYOUT_PROVIDER=mock                    # mock | razorpayx | dwolla
PAYOUT_MODE=sandbox                     # sandbox | live
LIVE_PAYOUTS_ACKNOWLEDGEMENT=           # must equal I_UNDERSTAND_REAL_MONEY_WILL_MOVE to allow live mode
MOCK_WEBHOOK_SECRET=change-me-mock-webhook-secret
RAZORPAYX_KEY_ID=                       # rzp_test_... (test mode keys only in sandbox)
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=               # your RazorpayX TEST business account number
RAZORPAYX_WEBHOOK_SECRET=
DWOLLA_KEY=                             # Dwolla SANDBOX application key (dashboard → Applications)
DWOLLA_SECRET=
DWOLLA_WEBHOOK_SECRET=                  # set when you create a webhook subscription (needs a public HTTPS URL)
DWOLLA_FUNDING_SOURCE=                  # optional: funding source to pay from (default: your verified bank)
PAYOUT_TIMEOUT_SECONDS=15

# --- Scheduler
SCHEDULER_TICK_SECONDS=60
SCHEDULER_LEASE_SECONDS=300

# --- Demo seed (development only): python -m finguard.cli seed-demo
DEMO_PASSWORD=
